# ===== PostgreSQL =====
POSTGRES_USER=stroydoc
POSTGRES_PASSWORD=stroydoc
POSTGRES_DB=stroydoc
# Для запуска вне docker (alembic, pytest) замените host на localhost:5432
DATABASE_URL=postgresql+psycopg://stroydoc:stroydoc@db:5432/stroydoc

# ===== API =====
# Секрет для подписи JWT — в проде обязательно сменить (минимум 32 символа)
SECRET_KEY=dev-secret-change-me-please-use-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development

# Seed-администратор (создаётся командой python -m app.seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Администратор системы
DEFAULT_COMPANY_NAME=Компания по умолчанию

# Разрешённые origin для CORS (JSON-список)
CORS_ORIGINS=["http://localhost:3000"]

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
